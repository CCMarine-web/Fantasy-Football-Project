{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "crons": [
    { "path": "/api/cron/daily", "schedule": "0 10 * * *" },
    { "path": "/api/cron/weekly", "schedule": "0 13 * * 2" },
    { "path": "/api/cron/thursday", "schedule": "0 13 * * 4" }
  ]
}
